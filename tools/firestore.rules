rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ekaterina.belyakova.smo@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }

    match /students/{sid} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
      // ученик сам выбирает персонажа и копит прогресс тренажёра «Мои ошибки»
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'color', 'avatarChosen', 'trainer']);
      match /lessons/{id} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
    // правки текста учителем: видят все, меняет только учитель
    match /textedits/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // мои задания из конструктора: только учитель
    match /taskbank/{id} {
      allow read, write: if isAdmin();
    }
    match /board/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /sheets/{sid} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
      match /events/{id} {
        allow read, create: if signedIn();
        allow update, delete: if isAdmin();
      }
      match /presence/{role} {
        allow read, write: if signedIn();
      }
      match /hwphotos/{id} { allow read, create: if signedIn(); allow update, delete: if isAdmin(); }
      match /attempts/{id} {
        allow read: if signedIn();
        allow create, update, delete: if isAdmin();
      }
      match /{other}/{id} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }
  }
}
